{
  "name": "navigation-api",
  "version": "1.0.0",
  "description": "Navigation API microservice for the website builder",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.js",
    "start": "node dist/server.js",
    "migrate": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:postman": "newman run ../postman/navigation-api.postman_collection.json -e ../postman/local.postman_environment.json"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
