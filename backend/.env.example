NODE_ENV=development
PORT=4019
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=10000

# Database host/name only. Credentials are Docker secrets (files), never env values:
#   /run/secrets/db_user, /run/secrets/db_password   (or DB_USER_FILE / DB_PASSWORD_FILE)
DB_HOST=db
DB_PORT=5432
DB_NAME=navigation
DB_POOL_MAX=10

# Trusted identity provider
JWT_ISSUER=<trusted issuer URL>
JWT_AUDIENCE=<expected API audience>
JWT_JWKS_URL=<trusted JWKS URL (https outside development)>
JWT_ALGORITHMS=RS256

# Platform services
WEBSITE_API_URL=<website api base url>
PAGE_API_URL=<page api base url>
PUBLISHING_EVENT_SINK_URL=
INTEGRATION_TIMEOUT_MS=3000

# Limits / policy
MAX_TREE_DEPTH=5
MAX_ITEMS_PER_MENU=200
RATE_LIMIT_PER_MINUTE=1000
PUBLIC_NAVIGATION_ENABLED=true
APPROVED_SYSTEM_ROUTES=/login,/account,/cart,/search
